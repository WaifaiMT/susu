# PostgreSQL. With Docker: `docker compose up -d` uses these credentials.
DATABASE_URL=postgres://saas:saas@localhost:5432/susu

# Tests create and drop a throwaway database on this server (the user needs CREATEDB).
TEST_DATABASE_URL=postgres://saas:saas@localhost:5432/postgres

# Public URL of the app, used in invite links.
APP_URL=http://localhost:3000

# Payments. Susu is a demo: only the test provider, Paystack TEST keys, or the
# MTN MoMo SANDBOX are accepted. Live keys are refused.
#   fake      built-in test provider, no keys (default)
#   paystack  needs PAYSTACK_SECRET_KEY=sk_test_...
#   mtn_momo  needs the MTN_MOMO_* sandbox keys
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
# Payouts with MTN need its separate Disbursement product. Leave blank and
# pots can still be paid out in cash.
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
